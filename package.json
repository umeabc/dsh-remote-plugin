{
  "name": "dsh-remote-plugin",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "description": "DeepSeek Harness remote access, both directions: serve this desktop to a phone, and drive another desktop from here.",
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "core.js",
    "lan.js",
    "relay.js",
    "proxy.js",
    "tunnel.js",
    "direct.js",
    "qr.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "assets/*"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  }
}